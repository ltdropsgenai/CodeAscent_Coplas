{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/coplas.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "dist",
    "web-build",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js"
  ]
}
