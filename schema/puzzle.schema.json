{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coplas puzzle list",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "number", "date", "groups"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^coplas-[0-9]{4}$" },
      "number": { "type": "integer", "minimum": 1 },
      "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "groups": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["theme", "tier", "cardIds", "explanation"],
          "additionalProperties": false,
          "properties": {
            "theme": { "type": "string", "minLength": 1 },
            "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
            "cardIds": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "string" }
            },
            "explanation": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
