{
  "expo": {
    "name": "Coplas",
    "slug": "coplas",
    "version": "0.1.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f990c709-fa91-4123-9591-8c3a11ffbfcc",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "scheme": "coplas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#0B1026",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codeascent.coplas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.codeascent.coplas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0820"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0A0820",
          "imageWidth": 240
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A0820",
          "defaultChannel": "coplas.daily"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f990c709-fa91-4123-9591-8c3a11ffbfcc"
      }
    }
  }
}
